# -------------------------------------------------------------
# DATABASE (Neon Serverless PostgreSQL)
# -------------------------------------------------------------
# 1. Buka https://console.neon.tech
# 2. Buat project baru (contoh nama: "fintrack-db")
# 3. Pada Dashboard, pilih Connection Details:
#    - Aktifkan toggle "Pooled connection" untuk DATABASE_URL
#    - Matikan toggle "Pooled connection" untuk DIRECT_URL
# -------------------------------------------------------------

DATABASE_URL="postgresql://[user]:[password]@[ep-xyz-pooler].[region].neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[ep-xyz].[region].neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------
# AUTHENTICATION (Auth.js / NextAuth v5)
# Generate secret dengan: npx auth secret (atau string acak 32 karakter)
# -------------------------------------------------------------
AUTH_SECRET="ganti_dengan_random_secret_32_karakter_atau_jalankan_npx_auth_secret"
NEXTAUTH_URL="http://localhost:3000"
